NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:18000
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
NEXT_PUBLIC_FORCE_MOCK=false
WENLAN_FORCE_MOCK=false
SUPABASE_STORAGE_BUCKET=document-assets
SUPABASE_THUMBNAIL_BUCKET=document-thumbnails

# Document object storage. Use "supabase" for local/self-hosted Supabase Storage
# or "cos" for Tencent Cloud COS in production.
DOCUMENT_STORAGE_DRIVER=supabase
COS_BUCKET=replace-with-cos-bucket
COS_REGION=ap-shanghai
COS_SECRET_ID=replace-with-cos-secret-id
COS_SECRET_KEY=replace-with-cos-secret-key
COS_PUBLIC_BASE_URL=

# Optional: allow one administrator to log in with a short username.
# Keep real values only in local/production secret stores, never in git.
ADMIN_USERNAME=replace-with-admin-username
ADMIN_EMAIL=admin@example.com

# Invite registration mailer. Reuse the same SMTP account as self-hosted Supabase Auth
# or provide another monitored sender mailbox.
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=admin@example.com
SMTP_PASS=replace-with-smtp-password
SMTP_SENDER_NAME=Wenlan

# Knowledge-base answer generation. Admins use the server-side DeepSeek key.
# Non-admin users must enter their own API key in the chat composer.
KB_DEEPSEEK_BASE_URL=https://api.deepseek.com
KB_DEEPSEEK_API_KEY=replace-with-deepseek-api-key
KB_DEEPSEEK_CHAT_MODEL=deepseek-v4-flash

# Keep false for product demos. Set true only for local development when no model key is available.
KB_ALLOW_EXTRACTIVE_FALLBACK=false
