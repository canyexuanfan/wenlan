# =========================
# Wenlan self-hosted Supabase overlay
# Copy to: infra/supabase/runtime/.env.self-host
# This file is merged into the official Supabase docker .env
# =========================

# Identity
PROJECT_NAME=wenlan-prod
STUDIO_DEFAULT_ORGANIZATION=Wenlan
STUDIO_DEFAULT_PROJECT=Wenlan Production

# Public URLs
# Use local defaults first, then replace with your real domain before production.
SUPABASE_PUBLIC_URL=http://127.0.0.1:8000
API_EXTERNAL_URL=http://127.0.0.1:8000
SITE_URL=http://127.0.0.1:3000
ADDITIONAL_REDIRECT_URLS=

# Postgres
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POSTGRES_PASSWORD=replace-with-generated-postgres-password

# Auth keys
JWT_SECRET=replace-with-generated-jwt-secret
ANON_KEY=replace-with-generated-anon-key
SERVICE_ROLE_KEY=replace-with-generated-service-role-key
DISABLE_SIGNUP=true
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false

# Dashboard
DASHBOARD_USERNAME=wenlan_admin
DASHBOARD_PASSWORD=replace-with-generated-dashboard-password

# Internal encryption
SECRET_KEY_BASE=replace-with-generated-secret-key-base
VAULT_ENC_KEY=replace-with-generated-vault-key
PG_META_CRYPTO_KEY=replace-with-generated-pg-meta-key
POOLER_TENANT_ID=replace-with-generated-pooler-tenant-id

# Analytics / observability
LOGFLARE_PUBLIC_ACCESS_TOKEN=replace-with-generated-logflare-public-token
LOGFLARE_PRIVATE_ACCESS_TOKEN=replace-with-generated-logflare-private-token

# Storage protocol and local storage defaults
S3_PROTOCOL_ACCESS_KEY_ID=replace-with-generated-s3-protocol-access-key
S3_PROTOCOL_ACCESS_KEY_SECRET=replace-with-generated-s3-protocol-secret
MINIO_ROOT_PASSWORD=replace-with-generated-minio-password
GLOBAL_S3_BUCKET=document-assets
REGION=local
STORAGE_TENANT_ID=wenlan

# SMTP
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=mailer@example.com
SMTP_PASS=replace-with-smtp-password
SMTP_SENDER_NAME=Wenlan Docs

# Optional HTTPS proxy
PROXY_DOMAIN=
CERTBOT_EMAIL=
